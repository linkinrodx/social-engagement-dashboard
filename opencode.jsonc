{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ghznkyqfgsupbndnucuc",
      "enabled": true
    },
    "playwright": {
      "type": "local",
